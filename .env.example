

# mock | huggingface | azure_openai 
LLM_PROVIDER=mock


# --- Hugging Face (free, no card needed — currently the working provider
# used for the actual demo, since Azure OpenAI access had setup friction) ---
# Get a fine-grained token at huggingface.co -> Settings -> Access Tokens

LLM_PROVIDER=huggingface

# Hugging Face 

#HF_TOKEN=your_huggingface_token

#HF_MODEL=openai/gpt-oss-120b:together

# --- Azure OpenAI (intended/documented primary provider, matches TechLabs'
# Microsoft stack
# From your Azure OpenAI / Azure AI Foundry resource -> Keys and Endpoint:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01



# --- Storage / session ---
NOTES_DB_PATH=notes.db9
USER_ID=default_user



